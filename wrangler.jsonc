{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exodia",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "SEED", "id": "2706c6792c5c42bc85e62c54c3e42892" }
  ],
  "ratelimits": [
    {
      "name": "PARSE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
